        ROUND(SUM(SUM(ctbp.CliTrnBudgPlan)+SUM(ctbp.CliTrnNdsBudgPlan)) OVER (PARTITION BY EXTRACT(YEAR FROM ctbp.DataInfo),EXTRACT(MONTH FROM ctbp.DataInfo)), 2) AS Общая_Сумма_ГО_Месяц_План,
        ROUND(SUM((SUM(ctbp.CliTrnBudgPlan) + SUM(ctbp.CliTrnNdsBudgPlan)) - (SUM(ctbp.CliTrnCostBudgPlan) + SUM(ctbp.CliTrnNdsCostBudgPlan))) OVER (PARTITION BY EXTRACT(YEAR FROM ctbp.DataInfo),EXTRACT(MONTH FROM ctbp.DataInfo)), 2) AS Общая_Сумма_РТН_81_ГО_Месяц,
        ROUND(SUM(ctbp.CliTrnBudgPlan) / LAG(SUM(ctbp.CliTrnBudgPlan)) OVER (PARTITION BY 
        ctbp.SalesChannel, 
        ctbp.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbp.Class37_Code, 5)
        ORDER BY  EXTRACT(YEAR FROM ctbp.DataInfo),EXTRACT(MONTH FROM ctbp.DataInfo)), 2) AS КР_ГО_План,
        ROUND((SUM(ctbp.CliTrnBudgPlan) + SUM(ctbp.CliTrnNdsBudgPlan)) - (SUM(ctbp.CliTrnCostBudgPlan) + SUM(ctbp.CliTrnNdsCostBudgPlan)) / LAG((SUM(ctbp.CliTrnBudgPlan) + SUM(ctbp.CliTrnNdsBudgPlan)) - (SUM(ctbp.CliTrnCostBudgPlan) + SUM(ctbp.CliTrnNdsCostBudgPlan))) OVER (PARTITION BY 
        ctbp.SalesChannel,
        ctbp.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbp.Class37_Code, 5)
        ORDER BY EXTRACT(YEAR FROM ctbp.DataInfo), EXTRACT(MONTH FROM ctbp.DataInfo)), 2) AS КР_Разница_81_ГО
    FROM 
        DataPrime.CliTrnBudgPlan_Fin ctbp
    LEFT JOIN (
        SELECT  
            ClassGroup.ClassCodeSrc AS Clas37_Code,
            ClassGroup.ClassCodeGrp AS Class63_Code
        FROM ClassGroup
        WHERE ClassGroup.ClassTypeSrc = 37 
          AND ClassGroup.ClassTypeGrp = 63 
          AND ClassGroup.ClassCodeGrp LIKE 'УП%'
    ) RulesGroup ON LEFT(ctbp.Class37_Code, 5) = RulesGroup.Clas37_Code
                  AND RulesGroup.Class63_Code LIKE 'УП%'
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN Class305 ON ctbp.Class305_Code = Class305.Class305_Code
    GROUP BY
        EXTRACT(YEAR FROM ctbp.DataInfo),
        EXTRACT(MONTH FROM ctbp.DataInfo),
        ctbp.SalesChannel,
        ctbp.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbp.Class37_Code, 5)      
),
BudgPlanAcc AS (
    SELECT 
        EXTRACT(YEAR FROM ctbap.DataInfo) AS Год,
        EXTRACT(MONTH FROM ctbap.DataInfo) AS Месяц,
        ctbap.SalesChannel,
        ctbap.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbap.Class37_Code, 5) AS ОП, 
        ROUND(SUM(ctbap.CliTrnBudgPlan) + SUM(ctbap.CliTrnNdsBudgPlan), 2) AS План_ГО_CPC,
        ROUND(SUM(ctbap.CliTrnCostBudgPlan) + SUM(ctbap.CliTrnNdsCostBudgPlan), 2) AS Себестоимость_CPC,
        ROUND((SUM(ctbap.CliTrnBudgPlan) + SUM(ctbap.CliTrnNdsBudgPlan)) - (SUM(ctbap.CliTrnCostBudgPlan) + SUM(ctbap.CliTrnNdsCostBudgPlan)), 2) AS РТН_CPC,
        ROUND(SUM((SUM(ctbap.CliTrnBudgPlan) + SUM(ctbap.CliTrnNdsBudgPlan)) - (SUM(ctbap.CliTrnCostBudgPlan) + SUM(ctbap.CliTrnNdsCostBudgPlan))) OVER (PARTITION BY EXTRACT(YEAR FROM ctbap.DataInfo),EXTRACT(MONTH FROM ctbap.DataInfo)), 2) AS Общая_Сумма_РТН_СРС_ГО_Месяц,
        ROUND((SUM(ctbap.CliTrnBudgPlan) + SUM(ctbap.CliTrnNdsBudgPlan)) - (SUM(ctbap.CliTrnCostBudgPlan) + SUM(ctbap.CliTrnNdsCostBudgPlan)) / LAG((SUM(ctbap.CliTrnBudgPlan) + SUM(ctbap.CliTrnNdsBudgPlan)) - (SUM(ctbap.CliTrnCostBudgPlan) + SUM(ctbap.CliTrnNdsCostBudgPlan))) OVER (PARTITION BY 
        ctbap.SalesChannel,
        ctbap.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbap.Class37_Code, 5)
        ORDER BY EXTRACT(YEAR FROM ctbap.DataInfo), EXTRACT(MONTH FROM ctbap.DataInfo)), 2) AS КР_Разница_CPC_ГО
    FROM 
        DataPrime.CliTrnBudgPlanAcc_Fin ctbap
    LEFT JOIN (
        SELECT  
            ClassGroup.ClassCodeSrc AS Clas37_Code,
            ClassGroup.ClassCodeGrp AS Class63_Code
        FROM ClassGroup
        WHERE ClassGroup.ClassTypeSrc = 37 
          AND ClassGroup.ClassTypeGrp = 63 
          AND ClassGroup.ClassCodeGrp LIKE 'УП%'
    ) RulesGroup ON LEFT(ctbap.Class37_Code, 5) = RulesGroup.Clas37_Code
                  AND RulesGroup.Class63_Code LIKE 'УП%'
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN Class305 ON ctbap.Class305_Code = Class305.Class305_Code
    GROUP BY
        EXTRACT(YEAR FROM ctbap.DataInfo),
        EXTRACT(MONTH FROM ctbap.DataInfo),
        ctbap.SalesChannel,
        ctbap.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctbap.Class37_Code, 5))
SELECT
    COALESCE(bp.Год, bpa.Год) AS Год,
    COALESCE(bp.Месяц, bpa.Месяц) AS Месяц,
    COALESCE(bp.SalesChannel, bpa.SalesChannel) AS Канал_продаж,
    COALESCE(bp.SalesSubChannel, bpa.SalesSubChannel) AS Специализация,
    COALESCE(bp.Class63_Name_Level2, bpa.Class63_Name_Level2) AS РК,
    COALESCE(bp.Class63_Name_Level3, bpa.Class63_Name_Level3) AS ДП,
    COALESCE(bp.Class305_Name_Level1, bpa.Class305_Name_Level1) AS Товарное_направление,
    COALESCE(bp.Class305_Name_Level2, bpa.Class305_Name_Level2) AS Товарный_отдел,
    COALESCE(bp.ОП, bpa.ОП) AS ОП,
    bp.План_ГО_81 AS  ГО_План,
    bp.РТН_81 AS ГО_РТН_81,
    bpa.РТН_CPC AS ГО_РТН_CPC,
    bp.Общая_Сумма_ГО_Месяц_План AS Общая_Сумма_ГО_Месяц_План,
    bp.Общая_Сумма_РТН_81_ГО_Месяц AS Общая_Сумма_РТН_81_ГО_Месяц_План,
    bpa.Общая_Сумма_РТН_СРС_ГО_Месяц AS Общая_Сумма_РТН_СРС_ГО_Месяц_План,
    bp.КР_ГО_План AS КР_ГО_План,
    bpa.КР_Разница_CPC_ГО AS КР_Разница_CPC_ГО_План,
    bp.КР_Разница_81_ГО AS КР_Разница_81_ГО_План
FROM BudgPlan bp
FULL JOIN BudgPlanAcc bpa
    ON bp.Год = bpa.Год
    AND bp.Месяц = bpa.Месяц
    AND bp.SalesChannel = bpa.SalesChannel
    AND bp.SalesSubChannel = bpa.SalesSubChannel
    AND bp.Class63_Name_Level2 = bpa.Class63_Name_Level2
    AND bp.Class63_Name_Level3 = bpa.Class63_Name_Level3
    AND bp.Class305_Name_Level1 = bpa.Class305_Name_Level1
    AND bp.Class305_Name_Level2 = bpa.Class305_Name_Level2
    AND bp.ОП = bpa.ОП
 WHERE   COALESCE(bp.Год, bpa.Год) >= 2024 
    AND COALESCE(bp.Месяц, bpa.Месяц) = 8)
