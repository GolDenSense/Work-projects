WITH
table_fact  
AS (WITH Query1 AS (
    SELECT 
        ctdf.YearInfo AS Год,
        ctdf.MonthInfo AS Месяц,
        ctdf.SalesChannel AS Канал_продаж,
        ctdf.SalesSubChannel AS Специализация,
        Class63.Class63_Name_Level2 AS РК,
        Class63.Class63_Name_Level3 AS  ДП,
        Class305.Class305_Name_Level1 AS Товарное_направление,
        Class305.Class305_Name_Level2 AS Товарный_отдел,
        LEFT(ctdf.Class37_Code, 5) AS ОП,
        ROUND(SUM(ctdf.SumSaled), 2) AS ГО,
        ROUND(SUM(ctdf.SumSaled) - SUM(ctdf.Cost) - SUM(ctdf.SumRb), 2) AS Разница_81_ГО,
        ROUND(SUM(ctdf.SumSaled) - SUM(ctdf.CostAcc) - SUM(ctdf.SumRb), 2) AS Разница_СРС_ГО,
        ROUND(SUM(SUM(ctdf.SumSaled)) OVER (PARTITION BY ctdf.YearInfo,ctdf.MonthInfo), 2) AS Общая_Сумма_ГО_Месяц,
        ROUND(SUM(SUM(ctdf.SumSaled) - SUM(ctdf.Cost) - SUM(ctdf.SumRb)) OVER (PARTITION BY ctdf.YearInfo,ctdf.MonthInfo), 2) AS Общая_Сумма_РТН_81_ГО_Месяц,
        ROUND(SUM(SUM(ctdf.SumSaled) - SUM(ctdf.CostAcc) - SUM(ctdf.SumRb)) OVER (PARTITION BY ctdf.YearInfo,ctdf.MonthInfo), 2) AS Общая_Сумма_РТН_СРС_ГО_Месяц,
        ROUND(SUM(ctdf.SumSaled) / LAG(SUM(ctdf.SumSaled)) OVER (PARTITION BY 
        ctdf.SalesChannel, 
        ctdf.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctdf.Class37_Code, 5)
        ORDER BY ctdf.YearInfo, ctdf.MonthInfo), 2) AS КР_ГО,
        ROUND(SUM(ctdf.SumSaled) - SUM(ctdf.Cost) - SUM(ctdf.SumRb) / LAG(SUM(ctdf.SumSaled) - SUM(ctdf.Cost) - SUM(ctdf.SumRb)) OVER (PARTITION BY 
        ctdf.SalesChannel,
        ctdf.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctdf.Class37_Code, 5)
        ORDER BY ctdf.YearInfo, ctdf.MonthInfo), 2) AS КР_Разница_81_ГО,
        ROUND(SUM(ctdf.SumSaled) - SUM(ctdf.CostAcc) - SUM(ctdf.SumRb) / LAG(SUM(ctdf.SumSaled) - SUM(ctdf.CostAcc) - SUM(ctdf.SumRb), 2) OVER (PARTITION BY 
        ctdf.SalesChannel,
        ctdf.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctdf.Class37_Code, 5)
        ORDER BY ctdf.YearInfo, ctdf.MonthInfo), 2) AS КР_Разница_CPC_ГО
    FROM 
        DataPrime.CliTurnoverDtl_Fin ctdf
    LEFT JOIN 
        (
            SELECT  
                ClassGroup.ClassCodeSrc AS Clas37_Code,
                ClassGroup.ClassCodeGrp AS Class63_Code
            FROM ClassGroup
            WHERE 
                ClassGroup.ClassTypeSrc = 37 
                AND ClassGroup.ClassTypeGrp = 63 
                AND ClassGroup.ClassCodeGrp LIKE 'УП%'
        ) AS RulesGroup
        ON LEFT(ctdf.Class37_Code, 5) = RulesGroup.Clas37_Code
        AND RulesGroup.Class63_Code LIKE 'УП%'
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN RgdDivisDprt ON ctdf.RgdCode = RgdDivisDprt.RgdCode
    LEFT JOIN Class305 ON RgdDivisDprt.Class305_Code = Class305.Class305_Code
    LEFT JOIN DescRgd ON ctdf.RgdCode = DescRgd.RgdCode
    LEFT JOIN Class33 ON DescRgd.Class33_Code = Class33.Class33_Code
    LEFT JOIN DescMan dm2 ON dm2.ManCode = ctdf.ManCode
    LEFT JOIN Class33 c2 ON DescRgd.Class33_Code = c2.Class33_Code
    WHERE 
        ctdf.YearInfo >= 2024 
        AND ctdf.MonthInfo = 8
        AND LEFT(c2.Class33_Code, 1) not like '6%'
    GROUP BY 
        ctdf.YearInfo,
        ctdf.MonthInfo,
        ctdf.SalesChannel,
        ctdf.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(ctdf.Class37_Code, 5)
),
Query2 AS (
    SELECT 
        o.YearInfo AS Год,
        o.MonthInfo AS Месяц,
        o.SalesChannel AS Канал_продаж,
        o.SalesSubChannel AS Специализация,
        Class63.Class63_Name_Level2 AS РК,
        Class63.Class63_Name_Level3 AS  ДП,
        Class305.Class305_Name_Level1 AS Товарное_направление,
        Class305.Class305_Name_Level2 AS Товарный_отдел,
        LEFT(o.Class37_Code, 5) AS ОП,
        ROUND(SUM(o.SumSaled), 2) AS ТО,
        ROUND(SUM(o.SumSaled) - SUM(o.Cost) - SUM(o.SumRb), 2) AS Разница_81_ТО,
        ROUND(SUM(o.SumSaled) - SUM(o.CostAcc) - SUM(o.SumRb), 2) AS Разница_СРС_ТО,
        ROUND(SUM(SUM(o.SumSaled)) OVER (PARTITION BY o.YearInfo,o.MonthInfo), 2) AS Общая_Сумма_ТО_Месяц,
        ROUND(SUM(SUM(o.SumSaled) - SUM(o.Cost) - SUM(o.SumRb)) OVER (PARTITION BY o.YearInfo,o.MonthInfo), 2) AS Общая_Сумма_РТН_81_ТО_Месяц,
        ROUND(SUM(SUM(o.SumSaled) - SUM(o.CostAcc) - SUM(o.SumRb)) OVER (PARTITION BY o.YearInfo,o.MonthInfo), 2) AS Общая_Сумма_РТН_СРС_ТО_Месяц,
        ROUND(SUM(o.SumSaled) / LAG(SUM(o.SumSaled)) OVER (PARTITION BY 
        o.SalesChannel, 
        o.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(o.Class37_Code, 5)
        ORDER BY o.YearInfo, o.MonthInfo), 2) AS КР_ТО,
        ROUND(SUM(o.SumSaled) - SUM(o.Cost) - SUM(o.SumRb) / LAG(SUM(o.SumSaled) - SUM(o.Cost) - SUM(o.SumRb)) OVER (PARTITION BY 
        o.SalesChannel,
        o.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(o.Class37_Code, 5)
        ORDER BY o.YearInfo, o.MonthInfo), 2) AS КР_Разница_81_ТО,
        ROUND(SUM(o.SumSaled) - SUM(o.CostAcc) - SUM(o.SumRb) / LAG(SUM(o.SumSaled) - SUM(o.CostAcc) - SUM(o.SumRb)) OVER (PARTITION BY 
        o.SalesChannel,
        o.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(o.Class37_Code, 5)
        ORDER BY o.YearInfo, o.MonthInfo), 2) AS КР_Разница_CPC_ТО
        FROM 
           Ot o
        LEFT JOIN 
        (
            SELECT  
                ClassGroup.ClassCodeSrc AS Clas37_Code,
                ClassGroup.ClassCodeGrp AS Class63_Code
            FROM ClassGroup
            WHERE 
                ClassGroup.ClassTypeSrc = 37 
                AND ClassGroup.ClassTypeGrp = 63 
                AND ClassGroup.ClassCodeGrp LIKE 'УП%'
        ) AS RulesGroup
        ON LEFT(o.Class37_Code, 5) = RulesGroup.Clas37_Code
        AND RulesGroup.Class63_Code LIKE 'УП%'
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN RgdDivisDprt ON o.RgdCode = RgdDivisDprt.RgdCode
    LEFT JOIN Class305 ON RgdDivisDprt.Class305_Code = Class305.Class305_Code
    LEFT JOIN DescRgd ON o.RgdCode = DescRgd.RgdCode
    LEFT JOIN Class33 ON DescRgd.Class33_Code = Class33.Class33_Code
    LEFT JOIN DescMan dm2 ON dm2.ManCode = o.ManCode
    LEFT JOIN Class33 c2 ON DescRgd.Class33_Code = c2.Class33_Code
    WHERE 
        o.YearInfo >= 2024 
        AND o.MonthInfo = 8
        AND LEFT(c2.Class33_Code, 1) not like '6%'
    GROUP BY 
        o.YearInfo,
        o.MonthInfo,
        o.SalesChannel,
        o.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(o.Class37_Code, 5)
)
SELECT 
    COALESCE(q1.Год, q2.Год) AS Год,
    COALESCE(q1.Месяц, q2.Месяц) AS Месяц,
    COALESCE(q1.Канал_продаж, q2.Канал_продаж) AS Канал_продаж,
    COALESCE(q1.Специализация, q2.Специализация) AS Специализация,
    COALESCE(q1.РК, q2.РК) AS РК,
    COALESCE(q1.ДП, q2.ДП) AS ДП, 
    COALESCE(q1.Товарное_направление, q2.Товарное_направление) AS Товарное_направление,
    COALESCE(q1.Товарный_отдел, q2.Товарный_отдел) AS Товарный_отдел,
    COALESCE(q1.ОП, q2.ОП) AS ОП,
    q1.ГО AS ГО_Факт,
    q1.Разница_81_ГО AS Разница_81_ГО_Факт,
    q1.Разница_СРС_ГО AS Разница_СРС_ГО_Факт,
    q1.Общая_Сумма_ГО_Месяц AS Общая_Сумма_ГО_Месяц_Факт,
    q1.Общая_Сумма_РТН_81_ГО_Месяц AS Общая_Сумма_РТН_81_ГО_Месяц_Факт,
    q1.Общая_Сумма_РТН_СРС_ГО_Месяц AS Общая_Сумма_РТН_СРС_ГО_Месяц_Факт,
    q1.КР_ГО AS КР_ГО_Факт,
    q1.КР_Разница_81_ГО AS КР_Разница_81_ГО,
    q1.КР_Разница_CPC_ГО AS КР_Разница_CPC_ГО,
    q2.ТО AS ТО_Факт,
    q2.Разница_81_ТО AS Разница_81_ТО_Факт,
    q2.Разница_СРС_ТО AS Разница_СРС_ТО_Факт,
    q2.Общая_Сумма_ТО_Месяц AS Общая_Сумма_ТО_Месяц_Факт,
    q2.Общая_Сумма_РТН_81_ТО_Месяц AS Общая_Сумма_РТН_81_ТО_Месяц_Факт,
    q2.Общая_Сумма_РТН_СРС_ТО_Месяц AS Общая_Сумма_РТН_СРС_ТО_Месяц_Факт,
    q2.КР_ТО AS КР_ТО_Факт,
    q2.КР_Разница_81_ТО AS КР_Разница_81_ТО,
    q2.КР_Разница_CPC_ТО AS КР_Разница_CPC_ТО
FROM Query1 q1
FULL JOIN Query2 q2
    ON q1.Год = q2.Год
    AND q1.Месяц = q2.Месяц
    AND q1.Канал_продаж = q2.Канал_продаж
    AND q1.Специализация = q2.Специализация
    AND q1.РК = q2.РК
    AND q1.ДП = q2.ДП
    AND q1.Товарное_направление = q2.Товарное_направление
    AND q1.Товарный_отдел = q2.Товарный_отдел
    AND q1.ОП = q2.ОП
WHERE COALESCE(q1.Год, q2.Год) >= 2024
  AND COALESCE(q1.Месяц, q2.Месяц) = 8),
table_plan  
AS (WITH
t1 AS(WITH BudgPlanot AS (
    SELECT 
        EXTRACT(YEAR FROM otbp.DataInfo) AS Год,
        EXTRACT(MONTH FROM otbp.DataInfo) AS Месяц,
        otbp.SalesChannel,
        otbp.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbp.Class37_Code, 5) AS ОП, 
        ROUND(SUM(otbp.otBudgPlan) + SUM(otbp.otNdsBudgPlan), 2) AS План_ТО_81,
        ROUND(SUM(otbp.otCostBudgPlan) + SUM(otbp.otNdsCostBudgPlan), 2) AS Себестоимость_81,
        ROUND((SUM(otbp.otBudgPlan) + SUM(otbp.otNdsBudgPlan)) - (SUM(otbp.otCostBudgPlan) + SUM(otbp.otNdsCostBudgPlan)), 2) AS РТН_81,
        ROUND(SUM(SUM(otbp.otBudgPlan)+SUM(otbp.otNdsBudgPlan)) OVER (PARTITION BY EXTRACT(YEAR FROM otbp.DataInfo),EXTRACT(MONTH FROM otbp.DataInfo)), 2) AS Общая_Сумма_ТО_Месяц_План,
        ROUND(SUM((SUM(otbp.otBudgPlan) + SUM(otbp.otNdsBudgPlan)) - (SUM(otbp.otCostBudgPlan) + SUM(otbp.otNdsCostBudgPlan))) OVER (PARTITION BY EXTRACT(YEAR FROM otbp.DataInfo),EXTRACT(MONTH FROM otbp.DataInfo)), 2) AS Общая_Сумма_РТН_81_ТО_Месяц,
        ROUND((SUM(otbp.otBudgPlan)+SUM(otbp.otNdsBudgPlan)) / LAG(SUM(otbp.otBudgPlan)+SUM(otbp.otNdsBudgPlan)) OVER (PARTITION BY 
        otbp.SalesChannel, 
        otbp.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbp.Class37_Code, 5)
        ORDER BY EXTRACT(YEAR FROM otbp.DataInfo), EXTRACT(MONTH FROM otbp.DataInfo)), 5) AS КР_ТО_План,
        ROUND((SUM(otbp.otBudgPlan) + SUM(otbp.otNdsBudgPlan)) - (SUM(otbp.otCostBudgPlan) + SUM(otbp.otNdsCostBudgPlan)) / LAG((SUM(otbp.otBudgPlan) + SUM(otbp.otNdsBudgPlan)) - (SUM(otbp.otCostBudgPlan) + SUM(otbp.otNdsCostBudgPlan))) OVER (PARTITION BY 
        otbp.SalesChannel,
        otbp.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbp.Class37_Code, 5)
        ORDER BY EXTRACT(YEAR FROM otbp.DataInfo), EXTRACT(MONTH FROM otbp.DataInfo)), 2) AS КР_Разница_81_ТО
    FROM 
        DataPrime.otBudgPlan_Fin otbp
    LEFT JOIN (
        SELECT  
            ClassGroup.ClassCodeSrc AS Class37_Code,
            ClassGroup.ClassCodeGrp AS Class63_Code
        FROM ClassGroup
        WHERE ClassGroup.ClassTypeSrc = 37 
          AND ClassGroup.ClassTypeGrp = 63 
          AND ClassGroup.ClassCodeGrp LIKE 'УП%'
    ) RulesGroup ON LEFT(otbp.Class37_Code, 5) = RulesGroup.Class37_Code
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN Class305 ON otbp.Class305_Code = Class305.Class305_Code
    GROUP BY
        EXTRACT(YEAR FROM otbp.DataInfo),
        EXTRACT(MONTH FROM otbp.DataInfo),
        otbp.SalesChannel,
        otbp.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbp.Class37_Code, 5)
    ORDER BY Год, ОП),
BudgPlanAccot AS (
    SELECT 
        EXTRACT(YEAR FROM otbpa.DataInfo) AS Год,
        EXTRACT(MONTH FROM otbpa.DataInfo) AS Месяц,
        otbpa.SalesChannel,
        otbpa.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbpa.Class37_Code, 5) AS ОП, 
        ROUND(SUM(otbpa.otBudgPlan) + SUM(otbpa.otNdsBudgPlan), 2) AS План_ТО_CPC,
        ROUND(SUM(otbpa.otCostBudgPlan) + SUM(otbpa.otNdsCostBudgPlan), 2) AS Себестоимость_CPC,
        ROUND((SUM(otbpa.otBudgPlan) + SUM(otbpa.otNdsBudgPlan)) - (SUM(otbpa.otCostBudgPlan) + SUM(otbpa.otNdsCostBudgPlan)), 2) AS РТН_CPC,
        ROUND(SUM((SUM(otbpa.otBudgPlan) + SUM(otbpa.otNdsBudgPlan)) - (SUM(otbpa.otCostBudgPlan) + SUM(otbpa.otNdsCostBudgPlan))) OVER (PARTITION BY EXTRACT(YEAR FROM otbpa.DataInfo),EXTRACT(MONTH FROM otbpa.DataInfo)), 2) AS Общая_Сумма_РТН_СРС_ТО_Месяц,
        ROUND((SUM(otbpa.otBudgPlan) + SUM(otbpa.otNdsBudgPlan)) - (SUM(otbpa.otCostBudgPlan) + SUM(otbpa.otNdsCostBudgPlan)) / LAG((SUM(otbpa.otBudgPlan) + SUM(otbpa.otNdsBudgPlan)) - (SUM(otbpa.otCostBudgPlan) + SUM(otbpa.otNdsCostBudgPlan))) OVER (PARTITION BY 
        otbpa.SalesChannel,
        otbpa.SalesSubChannel,  
        Class63.Class63_Name_Level2, 
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbpa.Class37_Code, 5)
        ORDER BY EXTRACT(YEAR FROM otbpa.DataInfo), EXTRACT(MONTH FROM otbpa.DataInfo)), 2) AS КР_Разница_СРС_ТО
    FROM 
        DataPrime.otBudgPlanAcc_Fin otbpa
    LEFT JOIN (
        SELECT  
            ClassGroup.ClassCodeSrc AS Class37_Code,
            ClassGroup.ClassCodeGrp AS Class63_Code
        FROM ClassGroup
        WHERE ClassGroup.ClassTypeSrc = 37 
          AND ClassGroup.ClassTypeGrp = 63 
          AND ClassGroup.ClassCodeGrp LIKE 'УП%'
    ) RulesGroup ON LEFT(otbpa.Class37_Code, 5) = RulesGroup.Class37_Code
    LEFT JOIN Class63 ON RulesGroup.Class63_Code = Class63.Class63_Code
    LEFT JOIN Class305 ON otbpa.Class305_Code = Class305.Class305_Code
    GROUP BY
        EXTRACT(YEAR FROM otbpa.DataInfo),
        EXTRACT(MONTH FROM otbpa.DataInfo),
        otbpa.SalesChannel,
        otbpa.SalesSubChannel,
        Class63.Class63_Name_Level2,
        Class63.Class63_Name_Level3,
        Class305.Class305_Name_Level1,
        Class305.Class305_Name_Level2,
        LEFT(otbpa.Class37_Code, 5)
)
SELECT
    COALESCE(bpot.Год, bpaot.Год) AS Год,
    COALESCE(bpot.Месяц, bpaot.Месяц) AS Месяц,
    COALESCE(bpot.SalesChannel, bpaot.SalesChannel) AS Канал_продаж,
    COALESCE(bpot.SalesSubChannel, bpaot.SalesSubChannel) AS Специализация,
    COALESCE(bpot.Class63_Name_Level2, bpaot.Class63_Name_Level2) AS РК,
    COALESCE(bpot.Class63_Name_Level3, bpaot.Class63_Name_Level3) AS ДП,
    COALESCE(bpot.Class305_Name_Level1, bpaot.Class305_Name_Level1) AS Товарное_направление,
    COALESCE(bpot.Class305_Name_Level2, bpaot.Class305_Name_Level2) AS Товарный_отдел,
    COALESCE(bpot.ОП, bpaot.ОП) AS ОП,
    bpot.План_ТО_81 AS ТО_План,
    bpot.РТН_81 AS ТО_РТН_81,
    bpaot.РТН_CPC AS ТО_РТН_CPC,
    bpot.Общая_Сумма_ТО_Месяц_План,
    bpot.Общая_Сумма_РТН_81_ТО_Месяц AS Общая_Сумма_РТН_81_ТО_Месяц_План,
    bpaot.Общая_Сумма_РТН_СРС_ТО_Месяц AS Общая_Сумма_РТН_СРС_ТО_Месяц_План,
    bpot.КР_ТО_План,
    bpot.КР_Разница_81_ТО AS КР_Разница_81_ТО_План,
    bpaot.КР_Разница_СРС_ТО AS КР_Разница_СРС_ТО_План 
FROM BudgPlanot bpot
FULL JOIN BudgPlanAccot bpaot
    ON bpot.Год = bpaot.Год
    AND bpot.Месяц = bpaot.Месяц
    AND bpot.SalesChannel = bpaot.SalesChannel
    AND bpot.SalesSubChannel = bpaot.SalesSubChannel
    AND bpot.Class63_Name_Level2 = bpaot.Class63_Name_Level2
    AND bpot.Class63_Name_Level3 = bpaot.Class63_Name_Level3
    AND bpot.Class305_Name_Level1 = bpaot.Class305_Name_Level1
    AND bpot.Class305_Name_Level2 = bpaot.Class305_Name_Level2
    AND bpot.ОП = bpaot.ОП
  WHERE   COALESCE(bpot.Год, bpaot.Год) >= 2024 
    AND COALESCE(bpot.Месяц, bpaot.Месяц) = 8),
 t2 AS (WITH
BudgPlan AS (SELECT 
        EXTRACT(YEAR FROM ctbp.DataInfo) AS Год,
        EXTRACT(MONTH FROM ctbp.DataInfo) AS Месяц,
        ctbp.SalesChannel,
        ctbp.SalesSubChannel,
